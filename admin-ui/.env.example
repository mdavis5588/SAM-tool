# Copy to .env and fill in your values before running docker compose up

DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=samdb
DB_USER=sam_admin
DB_PASSWORD=your-db-password

SAM_CLIENT_SCHEMA=client_acme

ADMIN_USER=admin
ADMIN_PASSWORD=choose-a-strong-password

FLASK_SECRET=a-long-random-string-change-this

# Key required to call /api/dispatch-alerts from cron (leave blank to disable auth)
DISPATCH_KEY=another-random-string-change-this
